{
    "name": "markiu/api",
    "description": "API RESTful em PHP com arquitetura Service, Resource, Consumo de API e PHPUnit",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit",
        "start": "php -S 127.0.0.1:8000 -t public"
    }
}
